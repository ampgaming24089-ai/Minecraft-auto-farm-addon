      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? 3 : 0"
      },
      "minecraft:loot": {
        "table": "loot_tables/entities/chorus_hopper.json"
      },
      "minecraft:ageable": {
        "duration": 1200,
        "feed_items": [
          "minecraft:chorus_fruit"
        ],
        "grow_up": {
          "event": "minecraft:ageable_grow_up",
          "target": "self"
        }
      },
      "minecraft:breedable": {
