      "is_experimental": false
    },
    "components": {
      "minecraft:type_family": {
        "family": [
          "chorus_hopper",
          "voidbound",
          "mob"
        ]
      },
      "minecraft:collision_box": {
        "width": 0.7,
        "height": 0.6
      },
      "minecraft:health": {
        "value": 8,
        "max": 8
      },
      "minecraft:movement": {
        "value": 0.26
      },
      "minecraft:movement.basic": {},
      "minecraft:navigation.walk": {
        "can_path_over_water": false,
        "avoid_water": true,
        "can_pass_doors": false,
