        "tame_items": [
          "voidbound:bloom_pod"
        ],
        "tame_event": {
          "event": "minecraft:on_tame",
          "target": "self"
        }
      },
      "minecraft:breedable": {
        "require_tame": true,
        "breeds_with": [
          {
            "mate_type": "voidbound:glowmite",
            "baby_type": "voidbound:glowmite",
            "breed_event": {
              "event": "minecraft:entity_born",
              "target": "baby"
            }
          }
        ],
        "breed_items": [
          "voidbound:bloom_pod"
        ],
        "love_filters": {
          "test": "has_component",
          "subject": "self",
          "operator": "!=",
          "value": "minecraft:is_baby"
        }
      },
      "minecraft:behavior.panic": {
        "priority": 1,
        "speed_multiplier": 1.9
      },
      "minecraft:behavior.breed": {
        "priority": 2,
        "speed_multiplier": 1.0
      },
      "minecraft:behavior.follow_owner": {
        "priority": 3,
        "speed_multiplier": 1.2,
        "start_distance": 8,
        "stop_distance": 2
      },
      "minecraft:behavior.tempt": {
        "priority": 4,
        "speed_multiplier": 1.4,
        "items": [
          "voidbound:bloom_pod"
        ]
      },
      "minecraft:behavior.random_stroll": {
        "priority": 6,
        "speed_multiplier": 1.0
      },
      "minecraft:behavior.look_at_player": {
        "priority": 7,
        "look_distance": 8
      },
      "minecraft:behavior.random_look_around": {
        "priority": 8
      },
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? 2 : 0"
      },
      "minecraft:loot": {
        "table": "loot_tables/entities/glowmite.json"
      }
