          ]
        }
      }
    },
    "component_groups": {
      "voidbound:tamed": {
        "minecraft:is_tamed": {},
        "minecraft:sittable": {},
        "minecraft:behavior.follow_owner": {
          "priority": 3,
          "speed_multiplier": 1.2,
          "start_distance": 8,
          "stop_distance": 2
        },
        "minecraft:health": {
          "value": 20,
          "max": 20
        }
      },
      "voidbound:baby": {
        "minecraft:is_baby": {},
        "minecraft:scale": {
          "value": 0.55
        },
        "minecraft:ageable": {
          "duration": 1200,
          "feed_items": [
            "voidbound:bloom_pod"
          ],
          "grow_up": {
            "event": "voidbound:grow_up",
            "target": "self"
          }
        }
      }
